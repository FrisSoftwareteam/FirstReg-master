@model SecurityDetailsModel

@{
    ViewData["Title"] = "Account Details";
}

<div class="page-header mb-15">
    <div class="media mb-3">
        <div class="media-body">
            <div class="row">
                <div class="col-lg mb-3 mb-lg-0">
                    <h1 class="page-header-title">@Model.Company</h1>

                    <div class="row align-items-center">
                        <div class="col-auto">
                            <span>Account:</span>
                            <span>#@Model.AccountNo - @Model.Holder</span>
                        </div>
                    </div>
                </div>

                <div class="col-lg-auto">
                    <a asp-action="Details" asp-route-code="@Model.ShareholderCode" class="btn btn-primary pe-7">
                        <span class="svg-icon svg-icon-2 me-0">
                            <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1">
                                <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                    <polygon points="0 0 24 0 24 24 0 24" />
                                    <path d="M6.70710678,15.7071068 C6.31658249,16.0976311 5.68341751,16.0976311 5.29289322,15.7071068 C4.90236893,15.3165825 4.90236893,14.6834175 5.29289322,14.2928932 L11.2928932,8.29289322 C11.6714722,7.91431428 12.2810586,7.90106866 12.6757246,8.26284586 L18.6757246,13.7628459 C19.0828436,14.1360383 19.1103465,14.7686056 18.7371541,15.1757246 C18.3639617,15.5828436 17.7313944,15.6103465 17.3242754,15.2371541 L12.0300757,10.3841378 L6.70710678,15.7071068 Z" fill="#000000" fill-rule="nonzero" transform="translate(12.000003, 11.999999) scale(-1, 1) rotate(-270.000000) translate(-12.000003, -11.999999) " />
                                </g>
                            </svg>
                        </span>
                        Back
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="card mb-5 mb-xl-10">
    <div class="card-body py-10">
        <h2 class="mb-9">Account Summary</h2>
        <p class="fs-5 fw-bold text-gray-600">
            Here's a summary of your account at @Model.Company. This page also shows the
            details of your transaction as well as your dividend history.
        </p>
        <div class="row py-6">
            <div class="col">
                <div class="card card-dashed flex-center min-w-175px my-3 p-6">
                    <span class="fs-4 fw-bold text-success pb-1 px-2">Total Bought</span>
                    <span class="fs-lg-2tx fw-bolder d-flex justify-content-center">
                        <span data-kt-countup="true" data-kt-countup-value="@Model.TotalnitsIn" class="counted">@Model.TotalnitsInString</span>
                    </span>
                </div>
            </div>
            <div class="col">
                <div class="card card-dashed flex-center min-w-175px my-3 p-6">
                    <span class="fs-4 fw-bold text-danger pb-1 px-2">Total Sold</span>
                    <span class="fs-lg-2tx fw-bolder d-flex justify-content-center">
                        <span data-kt-countup="true" data-kt-countup-value="@Model.TotalnitsOut" class="counted">@Model.TotalnitsOutString</span>
                    </span>
                </div>
            </div>
            <div class="col">
                <div class="card card-dashed flex-center min-w-175px my-3 p-6">
                    <span class="fs-4 fw-bold text-info pb-1 px-2">Units Balance</span>
                    <span class="fs-lg-2tx fw-bolder d-flex justify-content-center">
                        <span data-kt-countup="true" data-kt-countup-value="@Model.UnitsBalance" class="counted">@Model.UnitsBalanceString</span>
                    </span>
                </div>
            </div>
            <div class="col">
                <div class="card card-dashed flex-center min-w-175px my-3 p-6">
                    <span class="fs-4 fw-bold text-primary pb-1 px-2">Total Dividend</span>
                    <span class="fs-lg-2tx fw-bolder d-flex justify-content-center">
                        <span data-kt-countup="true" data-kt-countup-value="@Model.TotalDividend" class="counted">@Model.TotalDividendString</span>
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

@{
    var statement = ViewBag.Statement as RegisterHolderModel;
    var statementFailed = ViewBag.StatementFailed as bool? ?? false;
    string Dash(string value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    var registerName = Dash(statement?.Register ?? Model.Company);
    var holderName = Dash(statement?.Name ?? Model.Holder);
    var cscsNo = Dash(statement?.ClearingNo);
    var accNo = statement != null ? statement.AccountNo.ToString() : Dash(Model.AccountNo);
    var oldAcc = Dash(statement?.OldAccountNo);
    var holderAddress = Dash(statement?.Address);
    var downloadUrl = Url.Action("DownloadAccountDetails", new { no = Model.AccountNo });
}

<div class="card mb-5 mb-xl-10 print-section">
    <div class="card-header card-header-stretch">
        <h3 class="card-title">Shareholder Details</h3>
        <div class="card-toolbar">
            <div class="btn-group" role="group">
                <button type="button" id="tab_btn_cert" class="btn btn-sm btn-primary" onclick="switchTab('kt_tab_pane_7', 'tab_btn_cert', 'tab_btn_divs')">Certificate</button>
                <button type="button" id="tab_btn_divs" class="btn btn-sm btn-light" onclick="switchTab('kt_tab_pane_8', 'tab_btn_divs', 'tab_btn_cert')">Dividends</button>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="tab-content" id="myTabContent">
            <div class="tab-pane fade show active" id="kt_tab_pane_7" role="tabpanel">
                <div class="d-flex flex-wrap flex-stack mb-7">
                    <div class="d-flex flex-column flex-wrap align-items-start my-1">
                        <h1 class="page-header-title">Statement of account as at @DateTime.Now.ToString("dd-MMM-yyyy")</h1>
                    </div>
                    <div class="d-flex flex-wrap my-1 no-print">
                        <a href="@downloadUrl" class="btn btn-dark btn-active-dark ms-1">Export</a>
                        <button type="button" class="btn btn-dark btn-active-dark ms-1" onclick="window.print()">Print</button>
                        <a asp-action="Details" asp-route-code="@Model.ShareholderCode" class="btn btn-danger btn-active-dark ms-1">Close</a>
                    </div>
                </div>

                <div class="d-flex flex-wrap">
                    <div class="min-w-75px pe-4 me-6 mb-3">
                        <div class="fw-semibold fs-6 text-gray-400">Register:</div>
                        <div class="fs-5 fw-bold">@registerName</div>
                    </div>
                    <div class="min-w-75px pe-4 me-6 mb-3">
                        <div class="fw-semibold fs-6 text-gray-400">Name:</div>
                        <div class="fs-5 fw-bold">@holderName</div>
                    </div>
                    <div class="min-w-75px pe-4 me-6 mb-3">
                        <div class="fw-semibold fs-6 text-gray-400">CSCS No:</div>
                        <div class="fs-5 fw-bold">@cscsNo</div>
                    </div>
                    <div class="min-w-75px pe-4 me-6 mb-3">
                        <div class="fw-semibold fs-6 text-gray-400">Acc No:</div>
                        <div class="fs-5 fw-bold">@accNo</div>
                    </div>
                    <div class="min-w-75px pe-4 me-6 mb-3">
                        <div class="fw-semibold fs-6 text-gray-400">Old Acc:</div>
                        <div class="fs-5 fw-bold">@oldAcc</div>
                    </div>
                    <div class="min-w-75px pe-4 me-6 mb-3">
                        <div class="fw-semibold fs-6 text-gray-400">Address:</div>
                        <div class="fs-5 fw-bold">@holderAddress</div>
                    </div>
                </div>

                @if (statement != null && statement.Units.Any())
                {
                    decimal runningBalance = 0;
                    int sn = 0;
                    <div class="table-responsive mt-5">
                        <table class="table table-striped fs-6 fw-bold gy-3 gs-5">
                            <thead>
                                <tr class="fw-bolder fs-6 text-dark border-bottom border-gray-200">
                                    <th>S/N</th>
                                    <th>Cert. No</th>
                                    <th>Old Cert. No</th>
                                    <th>Trans Date</th>
                                    <th>Narration</th>
                                    <th class="text-end">Buy</th>
                                    <th class="text-end">Sell</th>
                                    <th class="text-end">Balance</th>
                                    <th class="text-center">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var unit in statement.Units)
                                {
                                    sn++;
                                    var buy = unit.TotalUnits > 0 ? unit.TotalUnits : 0;
                                    var sell = unit.TotalUnits < 0 ? Math.Abs(unit.TotalUnits) : 0;
                                    runningBalance += buy - sell;
                                    <tr>
                                        <td>@sn</td>
                                        <td>@(unit.CertNo > 0 ? unit.CertNo.ToString() : "-")</td>
                                        <td>@Dash(unit.OldCertNo)</td>
                                        <td>@Dash(unit.Date)</td>
                                        <td>@Dash(string.IsNullOrWhiteSpace(unit.Narration) ? unit.Description : unit.Narration)</td>
                                        <td class="text-end">@(buy > 0 ? buy.ToString("N0") : "-")</td>
                                        <td class="text-end">@(sell > 0 ? sell.ToString("N0") : "-")</td>
                                        <td class="text-end">@runningBalance.ToString("N0")</td>
                                        <td class="text-center">@Dash(unit.Status)</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="fw-bolder">
                                    <th colspan="7" class="text-end">Balance:</th>
                                    <th class="text-end">@statement.TotalUnits.ToString("N0")</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
                else if (statementFailed)
                {
                    <div class="alert alert-warning d-flex flex-column flex-sm-row align-items-sm-center gap-3 mt-4 no-print">
                        <div class="flex-grow-1">
                            <div class="fw-bold">The statement could not be loaded right now.</div>
                            <div class="fs-7">The register records service took too long to respond. Please try again in a moment.</div>
                        </div>
                        <a href="@Context.Request.Path" class="btn btn-sm btn-warning">Try again</a>
                    </div>
                }
                else if (statement == null)
                {
                    <div class="text-gray-600 fs-6 mt-4">No register record was found for this account. Please contact First Registrars to confirm the account details.</div>
                }
                else
                {
                    <div class="text-gray-600 fs-6 mt-4">No certificate statement is available for this account.</div>
                }
            </div>

            <div class="tab-pane fade" id="kt_tab_pane_8" role="tabpanel">
                <div class="d-flex flex-wrap flex-stack mb-7">
                    <div class="d-flex flex-column flex-wrap align-items-start my-1">
                        <h1 class="page-header-title">Dividend history as at @DateTime.Now.ToString("dd-MMM-yyyy")</h1>
                    </div>
                    <div class="d-flex flex-wrap my-1 no-print">
                        <a href="@downloadUrl" class="btn btn-dark btn-active-dark ms-1">Export</a>
                        <button type="button" class="btn btn-dark btn-active-dark ms-1" onclick="window.print()">Print</button>
                        <a asp-action="Details" asp-route-code="@Model.ShareholderCode" class="btn btn-danger btn-active-dark ms-1">Close</a>
                    </div>
                </div>

                <div class="d-flex flex-wrap">
                    <div class="min-w-75px pe-4 me-6 mb-3">
                        <div class="fw-semibold fs-6 text-gray-400">Register:</div>
                        <div class="fs-5 fw-bold">@registerName</div>
                    </div>
                    <div class="min-w-75px pe-4 me-6 mb-3">
                        <div class="fw-semibold fs-6 text-gray-400">Name:</div>
                        <div class="fs-5 fw-bold">@holderName</div>
                    </div>
                    <div class="min-w-75px pe-4 me-6 mb-3">
                        <div class="fw-semibold fs-6 text-gray-400">CSCS No:</div>
                        <div class="fs-5 fw-bold">@cscsNo</div>
                    </div>
                    <div class="min-w-75px pe-4 me-6 mb-3">
                        <div class="fw-semibold fs-6 text-gray-400">Acc No:</div>
                        <div class="fs-5 fw-bold">@accNo</div>
                    </div>
                    <div class="min-w-75px pe-4 me-6 mb-3">
                        <div class="fw-semibold fs-6 text-gray-400">Old Acc:</div>
                        <div class="fs-5 fw-bold">@oldAcc</div>
                    </div>
                    <div class="min-w-75px pe-4 me-6 mb-3">
                        <div class="fw-semibold fs-6 text-gray-400">Address:</div>
                        <div class="fs-5 fw-bold">@holderAddress</div>
                    </div>
                </div>

                @if (statement != null && statement.Dividends.Any())
                {
                    int dsn = 0;
                    <div class="table-responsive mt-5">
                        <table class="table table-striped fs-6 fw-bold gy-3 gs-5">
                            <thead>
                                <tr class="fw-bolder fs-6 text-dark border-bottom border-gray-200">
                                    <th>S/N</th>
                                    <th>Date</th>
                                    <th>Date Paid</th>
                                    <th>Div. No</th>
                                    <th>Warr. No</th>
                                    <th>Type</th>
                                    <th class="text-end">Units</th>
                                    <th class="text-end">Gross</th>
                                    <th class="text-end">Tax</th>
                                    <th class="text-end">Net</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var div in statement.Dividends)
                                {
                                    dsn++;
                                    <tr>
                                        <td>@dsn</td>
                                        <td>@Dash(div.Date)</td>
                                        <td>@Dash(div.DatePaid)</td>
                                        <td>@(div.DividendNo > 0 ? div.DividendNo.ToString() : "-")</td>
                                        <td>@(div.WarrantNo > 0 ? div.WarrantNo.ToString() : "-")</td>
                                        <td>@Dash(div.Type)</td>
                                        <td class="text-end">@(div.Total.HasValue ? div.Total.Value.ToString("N0") : "-")</td>
                                        <td class="text-end">@(div.Gross.HasValue ? div.Gross.Value.ToString("N2") : "-")</td>
                                        <td class="text-end">@(div.Tax.HasValue ? div.Tax.Value.ToString("N2") : "-")</td>
                                        <td class="text-end">@(div.Net.HasValue ? div.Net.Value.ToString("N2") : "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-gray-600 fs-6 mt-4">No dividend history is available for this account.</div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/pages/acc-details.js" asp-append-version="true"></script>
    <script>
        function switchTab(paneId, activeBtn, inactiveBtn) {
            document.querySelectorAll('#myTabContent .tab-pane').forEach(function (p) {
                p.classList.remove('show', 'active');
            });
            var pane = document.getElementById(paneId);
            if (pane) { pane.classList.add('show', 'active'); }

            var ab = document.getElementById(activeBtn);
            var ib = document.getElementById(inactiveBtn);
            if (ab) { ab.classList.replace('btn-light', 'btn-primary'); }
            if (ib) { ib.classList.replace('btn-primary', 'btn-light'); }
        }
    </script>
} 