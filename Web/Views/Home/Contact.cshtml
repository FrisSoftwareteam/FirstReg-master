@{
    ViewBag.Title = "Contact Us";
}

<style>
    .contact-us-promo .contact-promo-info p,
    .liaison-office-card p {
        color: #1e293b;
    }

    .contact-phone-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .contact-phone-list li + li {
        margin-top: 0.35rem;
    }

    .contact-phone-list a {
        text-decoration: none;
        font-weight: 600;
        color: var(--bs-primary);
    }

    .contact-phone-list a:hover {
        text-decoration: underline;
    }

    .liaison-office-card {
        min-height: 100%;
    }

    .liaison-office-card .liaison-body {
        flex: 1 1 auto;
    }
</style>

<section class="hero-section ptb-100 position-relative overflow-hidden" style="background: url('assets/img/shape/color-particles-2.svg')no-repeat center top">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-xl-8 col-lg-10 mb-5">
                <div class="hero-content-wrap">
                    <h1 class="fw-bold display-5 aos-init aos-animate" data-aos="fade-up">Contact Us</h1>
                </div>
            </div>
        </div>
        <div class="row justify-content-center align-items-stretch">
            <div class="col-lg-4 col-md-6 mt-4 mt-lg-0">
                <div class="contact-us-promo p-5 bg-white rounded-custom custom-shadow text-center d-flex flex-column h-100">
                    <span class="fad fa-comment-alt-lines fa-3x text-primary"></span>
                    <div class="contact-promo-info mb-4">
                        <h5>Visit Us Today</h5>
                        <p class="mb-0">
                            No. 2, Abebe Village Road,<br />
                            Iganmu, Lagos,<br />
                            P. M. B. 12692, Marina, Lagos.
                        </p>
                        <p class="mt-3 mb-0">
                            <strong>Monday to Friday</strong><br />
                            <strong>9am – 2pm WAT</strong>
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 mt-4 mt-lg-0">
                <div class="contact-us-promo p-5 bg-white rounded-custom custom-shadow text-center d-flex flex-column h-100">
                    <span class="fad fa-envelope fa-3x text-primary"></span>
                    <div class="contact-promo-info mb-4">
                        <h5>Email Us</h5>
                        <p>
                            You can drop us an email at
                            <a href="mailto:info@firstregistrarsnigeria.com"><strong>info@firstregistrarsnigeria.com</strong></a>
                            and you'll receive a reply from one of our representatives.
                        </p>
                    </div>
                    <a href="mailto:info@firstregistrarsnigeria.com" class="btn btn-primary mt-auto">Email Us</a>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 mt-4 mt-lg-0">
                <div class="contact-us-promo p-5 bg-white rounded-custom custom-shadow text-center d-flex flex-column h-100">
                    <span class="fad fa-phone fa-3x text-primary"></span>
                    <div class="contact-promo-info mb-4">
                        <h5>Give Us a Call</h5>
                        <p>
                            Give us a ring. Our experts are standing by
                            <strong>Monday to Friday</strong> from
                            <strong>9am – 3pm WAT</strong>.
                        </p>
                    </div>
                    <ul class="contact-phone-list mt-auto">
                        <li><a href="tel:+2349154123719">0915 412 3719</a></li>
                        <li><a href="tel:+2349154123720">0915 412 3720</a></li>
                        <li><a href="tel:+2349154123721">0915 412 3721</a></li>
                        <li><a href="tel:+2349154123722">0915 412 3722</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

