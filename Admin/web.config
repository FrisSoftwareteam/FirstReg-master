<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- disableStartUpErrorPage: when the app cannot start (500.30 etc.), let IIS show our
           branded "work in progress" page below instead of the default ASP.NET Core error. -->
      <aspNetCore processPath="dotnet" arguments=".\FirstReg.Admin.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" disableStartUpErrorPage="true" />
      <!-- existingResponse="Auto": the running app's own responses pass through untouched;
           only errors raised by IIS / the ASP.NET Core module itself are replaced. -->
      <httpErrors errorMode="Custom" existingResponse="Auto">
        <error statusCode="500" subStatusCode="30" path="wwwroot\maintenance.html" responseMode="File" />
        <error statusCode="500" subStatusCode="31" path="wwwroot\maintenance.html" responseMode="File" />
        <error statusCode="500" subStatusCode="32" path="wwwroot\maintenance.html" responseMode="File" />
        <error statusCode="500" subStatusCode="33" path="wwwroot\maintenance.html" responseMode="File" />
        <error statusCode="500" subStatusCode="34" path="wwwroot\maintenance.html" responseMode="File" />
        <error statusCode="500" subStatusCode="35" path="wwwroot\maintenance.html" responseMode="File" />
        <error statusCode="500" subStatusCode="37" path="wwwroot\maintenance.html" responseMode="File" />
        <error statusCode="500" subStatusCode="38" path="wwwroot\maintenance.html" responseMode="File" />
        <remove statusCode="502" subStatusCode="-1" />
        <error statusCode="502" path="wwwroot\maintenance.html" responseMode="File" />
        <remove statusCode="503" subStatusCode="-1" />
        <error statusCode="503" path="wwwroot\maintenance.html" responseMode="File" />
      </httpErrors>
    </system.webServer>
  </location>
</configuration>
